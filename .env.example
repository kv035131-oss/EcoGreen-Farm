SECRET_KEY=your_secret_key_here
JWT_SECRET_KEY=your_jwt_secret_key_here

# Database Configuration (PostgreSQL optional, defaults to backend/database/app.db)
# SQLALCHEMY_DATABASE_URI=postgresql://user:password@localhost:5432/ecogreen_db

# Razorpay API Credentials
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_key_secret
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret
RAZORPAY_SIMULATE=true

# Power BI Credentials
POWERBI_USER=admin
POWERBI_PASSWORD=admin123

# Notifications Config
NOTIFY_MODE=simulate            # simulate | meta
PUBLIC_BASE_URL=https://your-ngrok-url.ngrok-free.app

# Email Notifications Config (Brevo SMTP Relay)
EMAIL_NOTIFY_MODE=smtp              # simulate | smtp
SMTP_SERVER=smtp-relay.brevo.com    # Brevo SMTP host
SMTP_PORT=587                       # STARTTLS port
SMTP_USERNAME=your_brevo_login_email@domain.com
SMTP_PASSWORD=your_brevo_smtp_key_here
SENDER_EMAIL=your_verified_sender@domain.com


